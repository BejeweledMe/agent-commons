{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-commons:schema:payload:blueprint-application:v1",
  "x-schema-name": "commons.payload.blueprint_application.v1",
  "x-event-types": ["blueprint_application.created", "blueprint_application.task_joined"],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "application_id": {}, "blueprint": {}, "objective_id": {}, "created_task_ids": {},
    "created_agent_ids": {}, "created_role_refs": {}, "task_id": {}, "expected_revision": {},
    "reason": {}
  },
  "oneOf": [
    {
      "required": ["application_id", "blueprint", "objective_id", "created_task_ids", "created_agent_ids", "created_role_refs"],
      "properties": {
        "application_id": {"type": "string", "pattern": "^application\\.[a-f0-9]{64}$"},
        "blueprint": {"type": "object", "additionalProperties": false, "required": ["id", "version", "revision"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}},
        "objective_id": {"type": ["string", "null"], "pattern": "^objective\\.[0-9A-HJKMNP-TV-Z]{26}$"},
        "created_task_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^task\\.[0-9A-HJKMNP-TV-Z]{26}$"}},
        "created_agent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^agent\\.[0-9A-HJKMNP-TV-Z]{26}$"}},
        "created_role_refs": {"type": "array", "items": {"type": "object"}}
      }
    },
    {
      "required": ["application_id", "task_id", "expected_revision", "reason"],
      "properties": {
        "application_id": {"type": "string", "pattern": "^application\\.[a-f0-9]{64}$"},
        "task_id": {"type": "string", "pattern": "^task\\.[0-9A-HJKMNP-TV-Z]{26}$"},
        "expected_revision": {"type": "string", "pattern": "^evt\\.[0-9A-HJKMNP-TV-Z]{26}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  ]
}
