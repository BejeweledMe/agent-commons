{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-commons:schema:payload:context-pack:v1",
  "x-schema-name": "commons.payload.context_pack.v1",
  "x-event-types": ["context_pack.created", "context_pack.revised"],
  "type": "object",
  "additionalProperties": false,
  "required": ["context_pack_id", "summary", "facts", "decision_refs", "open_questions"],
  "properties": {
    "context_pack_id": {
      "type": "string",
      "pattern": "^context_pack\\.[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "expected_revision": {
      "type": "string",
      "pattern": "^evt\\.[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "source_refs"],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:agent-commons:schema:common:v1#/$defs/revisionBoundRef"
            }
          }
        }
      }
    },
    "decision_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:agent-commons:schema:common:v1#/$defs/revisionBoundRef"
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
