+def test_explicit_hierarchy_fields_remain_in_snapshot_wire_mapping() -> None:
+    identifier = "task." + "1" * 26
+    payload = {
+        "task_id": identifier,
+        "title": "Component",
+        "description": "Explicit hierarchy",
+        "priority": "normal",
+        "acceptance_criteria": ["Done"],
+        "task_kind": "component",
+        "parent_task_id": None,
